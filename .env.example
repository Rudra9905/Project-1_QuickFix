# Database Configuration
DB_URL=jdbc:postgresql://your-db-url
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Local Development Database (optional)
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/quick_helper
LOCAL_DB_USERNAME=quick_helper_user
LOCAL_DB_PASSWORD=quick_helper_pass

# Cloudinary Configuration (required for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Configuration (required for payments)
STRIPE_SECRET_KEY=your_stripe_secret_key

# Redis Configuration (cache)
# Use rediss:// for TLS providers
REDIS_URL=redis://localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false

# RabbitMQ Configuration (message queue)
# Use amqps:// for TLS providers
RABBIT_URL=amqp://guest:guest@localhost:5672
RABBIT_SSL=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI
GEMINI_API_KEY=